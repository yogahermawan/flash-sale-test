NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://flash_sale:flash_sale@localhost:5432/flash_sale
TEST_DATABASE_URL=postgres://flash_sale:flash_sale@localhost:5432/flash_sale_test
REDIS_URL=redis://localhost:16379
INTERNAL_API_KEY=replace-with-a-long-local-development-secret
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000
REDIS_RATE_LIMIT_FAIL_OPEN=true

# Demo default embeds the worker; set false to run pnpm -C backend worker separately.
RUN_WORKER=true
